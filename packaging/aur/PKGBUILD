# Maintainer: Trevor I. Lasn <trevorlasn@gmail.com>
#
# Source of truth for https://aur.archlinux.org/packages/residue-bin.
# packaging/aur/update.sh TAG bumps pkgver and the checksums from the
# release's SHA256SUMS and regenerates .SRCINFO.
pkgname=residue-bin
pkgver=0.0.2
pkgrel=1
pkgdesc='Find the Git worktrees coding agents leave behind, and remove one only when nothing in it would be lost'
arch=('x86_64' 'aarch64')
url='https://github.com/whiteheap/residue'
license=('MIT')
depends=('git>=2.36')
provides=('residue')
conflicts=('residue')
options=('!debug' '!strip')
source_x86_64=("$url/releases/download/v$pkgver/residue-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/residue-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('9aac0a60a249d4bdd129cd1615566f2b6439186a6b6bd3b702e989b5aded0930')
sha256sums_aarch64=('72999412c0cec6149ad2f6f04cca7329a46df7ab97d5e6a7a59b424252b083cd')

package() {
  cd "residue-v$pkgver-$CARCH-unknown-linux-musl"
  install -Dm755 residue "$pkgdir/usr/bin/residue"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
