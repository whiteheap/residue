# Response headers for every static asset. Cloudflare reads this file at
# deploy time and does not serve it. site/README.md says how to check them.
# script-src and font-src name the site itself only: hero.js and the two
# IBM Plex Mono files. connect-src 'self' lets Lighthouse's robots.txt and
# llms.txt audits fetch those files from the page (lighthouse#17292).
# site/check.sh holds this policy to the exact value.
# No Strict-Transport-Security here: the whiteheap.com zone's HSTS setting
# sends it and replaces any a Worker sends (site/README.md, "HTTPS").
/*
  Content-Security-Policy: default-src 'none'; connect-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The install script reads as text in a browser, so people can check it
# before they pipe it to sh. Without this it is application/x-sh, a download.
/install.sh
  Content-Type: text/plain; charset=utf-8

# robots.txt, llms.txt, security.txt, the IndexNow key and the font license.
# Cloudflare serves a .txt file as text/plain with no charset; llms.txt and
# security.txt (RFC 9116) need one. The splat matches .well-known/ too.
/*.txt
  Content-Type: text/plain; charset=utf-8

# The fonts and the drawings: a returning reader keeps them a day without
# asking again. They change rarely, and a day-old font or drawing still fits
# the page. The pages, style.css and hero.js keep Cloudflare's default,
# max-age=0 with must-revalidate: they change together and must match, and
# their names carry no version.
/*.woff2
  Cache-Control: public, max-age=86400

/*.svg
  Cache-Control: public, max-age=86400
