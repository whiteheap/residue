// Cloudflare Workers Static Assets for the residue site, served at
// https://residue.whiteheap.com. site/README.md has the deploy steps and what
// each setting here decides.
{
  "name": "residue",
  "compatibility_date": "2026-11-07",
  // No "main": there is no Worker script, so every request is a static asset
  // request. Only site/public is uploaded, never the repository.
  "assets": {
    "directory": "./public",
    // An unknown path gets public/404.html with status 404, not the home page.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // A Custom Domain on the whiteheap.com zone, which is on the same account:
  // Cloudflare creates its DNS record and certificate on deploy.
  "routes": [{ "pattern": "residue.whiteheap.com", "custom_domain": true }],
  // One address only: no workers.dev subdomain.
  "workers_dev": false,
  // No per-version preview URLs: an upload must not publish a second address.
  "preview_urls": false
}
